{
  "name": "@tracore/sdk",
  "version": "0.1.1",
  "type": "module",
  "description": "Official TypeScript SDK for the Tracore API",
  "license": "MIT",
  "author": "Tracore",
  "homepage": "https://github.com/tracore-io/sdk-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tracore-io/sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/tracore-io/sdk-node/issues"
  },
  "keywords": [
    "tracore",
    "sdk",
    "openapi",
    "document-extraction",
    "api-client",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tracoreApiVersion": "0.5.0",
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsup",
    "clean": "git clean -xdf .cache dist .turbo node_modules",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@hey-api/openapi-ts": "0.94.0",
    "@types/node": "25.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
